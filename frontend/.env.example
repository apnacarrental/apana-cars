# --- LOCAL ENVIRONMENT ---
# Use these for local development.

# PostgreSQL Connection (Local or Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apnacars?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-string-for-local-dev"

# Admin Bootstrap (Used by scripts/setup-admin.ts)
ADMIN_EMAIL="admin@apnacars.local"
ADMIN_PASSWORD="supersecurepassword123"

# --- PRODUCTION ENVIRONMENT (Required) ---
# Replace the above with production values when deploying.

# DATABASE_URL="postgresql://username:password@your-cloud-db.com:5432/db"
# NEXTAUTH_URL="https://your-production-domain.com"
# NEXTAUTH_SECRET="generate-a-strong-random-string"
# ADMIN_EMAIL="real-admin@yourdomain.com"
# ADMIN_PASSWORD="strong-production-password"

# --- CLOUDINARY (Media Storage) ---
# Required for production media uploads.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# --- REDIS (Rate Limiting) ---
# Recommended for production serverless deployments (e.g. Upstash).
# UPSTASH_REDIS_URL=""
# UPSTASH_REDIS_TOKEN=""

# DIRECT_URL is required if using a pooled connection (like Neon) for migrations
# DIRECT_URL="postgresql://username:password@your-cloud-db.com:5432/db"
